<?xml version="1.0"?>
<robot name="ch07_four_wheel_robot">
  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
  <material name="yellow"><color rgba="0.9 0.8 0.1 1"/></material>
  <material name="blue"><color rgba="0.1 0.2 0.9 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="body_link"/>
    <origin xyz="0 0 0.25"/>
  </joint>
  <link name="body_link">
    <visual><geometry><box size="1 0.6 0.3"/></geometry><material name="red"/></visual>
    <collision><geometry><box size="1 0.6 0.3"/></geometry></collision>
    <inertial><mass value="10"/><inertia ixx="0.375" ixy="0" ixz="0" iyy="0.908" iyz="0" izz="1.133"/></inertial>
  </link>
  <joint name="wheel1_joint" type="continuous"><parent link="body_link"/><child link="wheel1_link"/><origin xyz="0.3 0.35 -0.1"/><axis xyz="0 1 0"/></joint>
  <link name="wheel1_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.1"/></geometry><material name="yellow"/></visual></link>
  <joint name="wheel2_joint" type="continuous"><parent link="body_link"/><child link="wheel2_link"/><origin xyz="0.3 -0.35 -0.1"/><axis xyz="0 1 0"/></joint>
  <link name="wheel2_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.1"/></geometry><material name="yellow"/></visual></link>
  <joint name="wheel3_joint" type="continuous"><parent link="body_link"/><child link="wheel3_link"/><origin xyz="-0.3 0.35 -0.1"/><axis xyz="0 1 0"/></joint>
  <link name="wheel3_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.1"/></geometry><material name="yellow"/></visual></link>
  <joint name="wheel4_joint" type="continuous"><parent link="body_link"/><child link="wheel4_link"/><origin xyz="-0.3 -0.35 -0.1"/><axis xyz="0 1 0"/></joint>
  <link name="wheel4_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.1"/></geometry><material name="yellow"/></visual></link>
  <joint name="laser_joint" type="fixed"><parent link="body_link"/><child link="laser_link"/><origin xyz="0.25 0 0.2"/></joint>
  <link name="laser_link"><visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="blue"/></visual></link>
</robot>
