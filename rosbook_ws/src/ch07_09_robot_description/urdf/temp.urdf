<?xml version="1.0"?>
<robot name="ros_dd">
    <link name="body_link">
        <!-- 시각화 형상 -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.6 0.3"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <!-- 물리 충돌 형상 -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.6 0.3"/>
            </geometry>
        </collision>

        <!-- 질량 및 관성 모멘트 -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0375" ixy="0" ixz="0" iyy="0.0908" iyz="0" izz="0.1133"/>
        </inertial>
    </link>

    <joint name="wheel1_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel1_link"/>
    <origin xyz="0.3 0.35 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="10.0"/>
</joint>

<link name="wheel1_link">
    <!-- 시각화 형상 -->
    <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
        <material name="yellow">
            <color rgba="1 1 0 1"/>
        </material>
    </visual>

    <!-- 물리 충돌 형상 (visual과 동일한 형상 및 각도) -->
    <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
    </collision>

    <!-- 질량 및 실린더 관성 모멘트 (질량 0.2kg 기준) -->
    <inertial>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <mass value="0.2"/>
        <!-- 원기둥 회전축 관성: ixx/izz = m/12*(3r^2 + h^2), iyy = 1/2*m*r^2 -->
        <inertia ixx="0.00129" ixy="0" ixz="0" iyy="0.00225" iyz="0" izz="0.00129"/>
    </inertial>
</link>

<joint name="wheel2_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel2_link"/>
    <origin xyz="0.3 -0.35 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="10.0"/>
</joint>

<link name="wheel2_link">
    <!-- 시각화 형상 -->
    <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
        <material name="yellow">
            <color rgba="1 1 0 1"/>
        </material>
    </visual>

    <!-- 물리 충돌 형상 -->
    <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
    </collision>

    <!-- 질량 및 실린더 관성 모멘트 (질량 0.2kg 기준) -->
    <inertial>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.00129" ixy="0" ixz="0" iyy="0.00225" iyz="0" izz="0.00129"/>
    </inertial>
</link>

<joint name="wheel3_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel3_link"/>
    <origin xyz="-0.3 0.35 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="10.0"/>
</joint>

<link name="wheel3_link">
    <!-- 시각화 형상 -->
    <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
        <material name="yellow">
            <color rgba="1 1 0 1"/>
        </material>
    </visual>

    <!-- 물리 충돌 형상 -->
    <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
    </collision>

    <!-- 질량 및 실린더 관성 모멘트 (질량 0.2kg 기준) -->
    <inertial>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.00129" ixy="0" ixz="0" iyy="0.00225" iyz="0" izz="0.00129"/>
    </inertial>
</link>

<joint name="wheel4_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel4_link"/>
    <origin xyz="-0.3 -0.35 -0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="10.0"/>
</joint>

<link name="wheel4_link">
    <!-- 시각화 형상 -->
    <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
        <material name="yellow">
            <color rgba="1 1 0 1"/>
        </material>
    </visual>

    <!-- 물리 충돌 형상 -->
    <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
            <cylinder radius="0.15" length="0.1"/>
        </geometry>
    </collision>

    <!-- 질량 및 실린더 관성 모멘트 (질량 0.2kg 기준) -->
    <inertial>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.00129" ixy="0" ixz="0" iyy="0.00225" iyz="0" izz="0.00129"/>
    </inertial>
</link>

<joint name="laser_joint" type="fixed">
    <parent link="body_link"/>
    <child link="laser_link"/>
    <origin
        xyz="0.25 0 0.20"
        rpy="0 0 0"/>
</joint>
<link name="laser_link">
    <visual>
        <geometry>
            <cylinder
                radius="0.05"
                length="0.04"/>
        </geometry>
        <material name="blue">
            <color rgba="0 0 1 1"/>
        </material>
    </visual>
</link>
</robot>