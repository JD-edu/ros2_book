<?xml version="1.0"?>
<package format="3">
  <name>ch17_mobile_robot</name>
  <version>0.1.0</version>
  <description>Chapter 17 complete two-wheel mobile robot.</description>
  <maintainer email="examples@example.com">ROS 2 Book</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend><depend>nav_msgs</depend><depend>rclpy</depend>
  <depend>std_msgs</depend><depend>tf2_ros</depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>python3-serial</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
